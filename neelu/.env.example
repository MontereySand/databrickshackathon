# Neelu environment configuration.
# Copy to .env for local overrides. LOCAL_SIM mode needs NONE of these.

# --- Runtime mode -----------------------------------------------------------
# LOCAL_SIM=true (default) runs fully locally with PGlite + mocked Databricks
# services. Set LOCAL_SIM=false to attempt DATABRICKS mode (requires the values
# below + the live adapters to be implemented — see HANDOFF.md).
LOCAL_SIM=true

# Port the server listens on. Databricks Apps inject DATABRICKS_APP_PORT.
# PORT=8000
# DATABRICKS_APP_PORT=8000

# --- Database ---------------------------------------------------------------
# If set, Neelu uses node-postgres against this connection string (Lakebase in
# DATABRICKS mode, or any local Postgres). If unset, Neelu uses in-process PGlite.
# DATABASE_URL=postgres://user:password@host:5432/neelu

# PGlite data directory for LOCAL_SIM. Use "memory" for an ephemeral DB.
# PGLITE_DATA_DIR=./.data/pglite

# --- Databricks resources (DATABRICKS mode) ---------------------------------
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=
# DATABRICKS_PROFILE=DEFAULT

# Unity Catalog catalog/schema holding governed source + analytics tables.
# UC_CATALOG=neelu
# UC_SCHEMA=silver

# AI Search / Vector Search index for guidance retrieval.
# AI_SEARCH_INDEX_NAME=neelu.silver.guidance_search_idx

# Model Serving / AI Gateway endpoint used for reasoning/drafting.
# MODEL_ENDPOINT_NAME=

# MLflow experiment for traces + eval metrics.
# MLFLOW_EXPERIMENT_NAME=/Users/<you>/neelu

# --- Neelu Agent ------------------------------------------------------------
# Server-side OpenAI key used by /api/provider/agent-chat. Never expose this to
# the browser or commit a real key.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
