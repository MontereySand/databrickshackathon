{
  "name": "neelu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Neelu — a Databricks-native water evidence ledger (phone-submitted field tests to cited, human-approved, auditable public-health action cases).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seedDemo.ts",
    "seed:fountains": "tsx scripts/generateFountains.ts",
    "reset-demo": "tsx scripts/resetDemo.ts",
    "eval": "tsx src/evals/runEval.ts",
    "check-scope": "tsx scripts/checkScope.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@databricks/lakebase": "^0.4.0",
    "@databricks/sdk-experimental": "^0.16.0",
    "@electric-sql/pglite": "^0.5.2",
    "@fontsource-variable/manrope": "^5.2.8",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "h3-js": "^4.4.0",
    "idb": "^8.0.3",
    "maplibre-gl": "^5.24.0",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.61.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6",
    "esbuild": "^0.28.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.8"
  }
}
